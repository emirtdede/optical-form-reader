{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Optical Form Reader",
  "version": "1.0.0",
  "identifier": "dev.vellium.opticalformreader",
  "mainBinaryName": "optical-form-reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Optical Form Reader",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "center": true,
        "shadow": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: mediastream:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://api.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com blob: data:; object-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Vellium",
    "homepage": "https://vellium.dev",
    "license": "MIT",
    "category": "Education",
    "copyright": "© 2026 Vellium Teknoloji Anonim Şirketi. All rights reserved.",
    "shortDescription": "Local-first optical mark recognition (OMR) and academic grading suite for Windows 11.",
    "longDescription": "Optical Form Reader by Vellium Teknoloji Anonim Şirketi evaluates 1-160 question optical answer sheets completely on your Windows 11 device using local computer vision (OpenCV WASM), live webcam auto-capture, multi-booklet grading (A-D), KR-20 item analysis, and Excel/PDF scorecard export - 100% offline with zero telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installerHeader.bmp",
        "sidebarImage": "icons/installerSidebar.bmp",
        "installerHooks": "nsis/hooks.nsh",
        "installMode": "currentUser",
