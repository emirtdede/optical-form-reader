LangString addOrReinstall ${LANG_UZBEK} "Komponentlarni qo'shish/qayta o'rnatish"
LangString alreadyInstalled ${LANG_UZBEK} "Allaqachon oʻrnatilgan"
LangString alreadyInstalledLong ${LANG_UZBEK} "${PRODUCTNAME} ${VERSION} allaqachon o'rnatilgan. Bajarmoqchi bo'lgan operatsiyani tanlang va davom etish uchun $\"Keyingi$\" tugmasini bosing."
LangString appRunning ${LANG_UZBEK} "{{product_name}} ishlamoqda! Iltimos, avval uni yoping, keyin qayta urinib ko'ring."
LangString appRunningOkKill ${LANG_UZBEK} "{{product_name}} ishlayapti! $\n Uni o'ldirish uchun OK tugmasini bosing"
LangString chooseMaintenanceOption ${LANG_UZBEK} "Amalga oshirish uchun parvarishlash variantini tanlang."
LangString choowHowToInstall ${LANG_UZBEK} "${PRODUCTNAME} qanday o'rnatilishini tanlang."
LangString createDesktop ${LANG_UZBEK} "Ish stoli yorlig'ini yarating"
LangString dontUninstall ${LANG_UZBEK} "Oʻchirib tashlamang"
LangString dontUninstallDowngrade ${LANG_UZBEK} "Oʻchirib tashlamang (Ushbu oʻrnatuvchi uchun oʻchirishsiz pasaytirish oʻchirib qoʻyilgan)"
LangString failedToKillApp ${LANG_UZBEK} "{{product_name}}-ni o‘ldirib bo‘lmadi. Iltimos, avval uni yoping, keyin qayta urinib ko'ring"
LangString installingWebview2 ${LANG_UZBEK} "WebView2 o'rnatilmoqda..."
LangString newerVersionInstalled ${LANG_UZBEK} "${PRODUCTNAME} ning yangiroq versiyasi allaqachon o'rnatilgan! Eski versiyani o'rnatish tavsiya etilmaydi. Agar siz haqiqatan ham ushbu eski versiyani o'rnatmoqchi bo'lsangiz, avval joriy versiyani o'chirib tashlang. Bajarmoqchi bo'lgan operatsiyani tanlang va davom etish uchun $\"Keyingi$\" tugmasini bosing."
LangString older ${LANG_UZBEK} "yoshi kattaroq"
LangString olderOrUnknownVersionInstalled ${LANG_UZBEK} "Tizimingizda ${PRODUCTNAME} ning $R4 versiyasi o‘rnatilgan. O'rnatishdan oldin joriy versiyani olib tashlash tavsiya etiladi. Bajarmoqchi bo'lgan operatsiyani tanlang va davom etish uchun $\"Keyingi$\" tugmasini bosing."
LangString silentDowngrades ${LANG_UZBEK} "Bu oʻrnatuvchi uchun pasaytirish oʻchirib qoʻyilgan, jim oʻrnatuvchi bilan davom etib boʻlmaydi, oʻrniga grafik interfeys oʻrnatuvchisidan foydalaning.$\n"
LangString unableToUninstall ${LANG_UZBEK} "Oʻchirib boʻlmadi!"
LangString uninstallApp ${LANG_UZBEK} "${PRODUCTNAME}-ni o'chirib tashlang"
LangString uninstallBeforeInstalling ${LANG_UZBEK} "O'rnatishdan oldin o'chirib tashlang"
LangString unknown ${LANG_UZBEK} "noma'lum"
LangString webview2AbortError ${LANG_UZBEK} "WebView2 o'rnatib bo'lmadi! Ilova usiz ishlay olmaydi. O'rnatuvchini qayta ishga tushirib ko'ring."
LangString webview2DownloadError ${LANG_UZBEK} "Xato: WebView2 yuklab olinmadi - $0"
LangString webview2DownloadSuccess ${LANG_UZBEK} "WebView2 yuklash dasturi yuklab olindi"
LangString webview2Downloading ${LANG_UZBEK} "WebView2 bootstrapper yuklab olinmoqda..."
LangString webview2InstallError ${LANG_UZBEK} "Xato: $1 chiqish kodi bilan WebView2 ni o‘rnatib bo‘lmadi"
LangString webview2InstallSuccess ${LANG_UZBEK} "WebView2 muvaffaqiyatli oʻrnatildi"
