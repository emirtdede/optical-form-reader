LangString addOrReinstall ${LANG_URDU} "اجزاء شامل کریں / دوبارہ انسٹال کریں۔"
LangString alreadyInstalled ${LANG_URDU} "پہلے سے انسٹال ہے۔"
LangString alreadyInstalledLong ${LANG_URDU} "${PRODUCTNAME} ${VERSION} پہلے سے ہی انسٹال ہے۔ آپ جس آپریشن کو کرنا چاہتے ہیں اسے منتخب کریں اور جاری رکھنے کے لیے اگلا پر کلک کریں۔"
LangString appRunning ${LANG_URDU} "{{product_name}} چل رہا ہے! براہ کرم پہلے اسے بند کریں پھر دوبارہ کوشش کریں۔"
LangString appRunningOkKill ${LANG_URDU} "{{product_name}} چل رہا ہے! $\n اسے مارنے کے لیے ٹھیک ہے پر کلک کریں۔"
LangString chooseMaintenanceOption ${LANG_URDU} "انجام دینے کے لیے دیکھ بھال کا اختیار منتخب کریں۔"
LangString choowHowToInstall ${LANG_URDU} "منتخب کریں کہ آپ کس طرح ${PRODUCTNAME} انسٹال کرنا چاہتے ہیں۔"
LangString createDesktop ${LANG_URDU} "ڈیسک ٹاپ شارٹ کٹ بنائیں"
LangString dontUninstall ${LANG_URDU} "ان انسٹال نہ کریں۔"
LangString dontUninstallDowngrade ${LANG_URDU} "ان انسٹال نہ کریں (اس انسٹالر کے لیے ان انسٹال کے بغیر ڈاؤن گریڈنگ غیر فعال ہے)"
LangString failedToKillApp ${LANG_URDU} "{{product_name}} کو مارنے میں ناکام۔ براہ کرم پہلے اسے بند کریں پھر دوبارہ کوشش کریں۔"
LangString installingWebview2 ${LANG_URDU} "WebView2 انسٹال ہو رہا ہے..."
LangString newerVersionInstalled ${LANG_URDU} "${PRODUCTNAME} کا ایک نیا ورژن پہلے ہی انسٹال ہے! یہ تجویز نہیں کی جاتی ہے کہ آپ پرانا ورژن انسٹال کریں۔ اگر آپ واقعی اس پرانے ورژن کو انسٹال کرنا چاہتے ہیں تو پہلے موجودہ ورژن کو ان انسٹال کرنا بہتر ہے۔ آپ جس آپریشن کو کرنا چاہتے ہیں اسے منتخب کریں اور جاری رکھنے کے لیے اگلا پر کلک کریں۔"
LangString older ${LANG_URDU} "بڑی عمر"
LangString olderOrUnknownVersionInstalled ${LANG_URDU} "آپ کے سسٹم پر ${PRODUCTNAME} کا $R4 ورژن انسٹال ہے۔ یہ تجویز کیا جاتا ہے کہ آپ انسٹال کرنے سے پہلے موجودہ ورژن کو اَن انسٹال کر لیں۔ آپ جس آپریشن کو کرنا چاہتے ہیں اسے منتخب کریں اور جاری رکھنے کے لیے اگلا پر کلک کریں۔"
LangString silentDowngrades ${LANG_URDU} "اس انسٹالر کے لیے ڈاؤن گریڈز غیر فعال ہیں، سائلنٹ انسٹالر کے ساتھ آگے نہیں بڑھ سکتے، براہ کرم اس کی بجائے گرافیکل انٹرفیس انسٹالر استعمال کریں۔$\n"
LangString unableToUninstall ${LANG_URDU} "اَن انسٹال کرنے سے قاصر!"
LangString uninstallApp ${LANG_URDU} "${PRODUCTNAME} اَن انسٹال کریں۔"
LangString uninstallBeforeInstalling ${LANG_URDU} "انسٹال کرنے سے پہلے ان انسٹال کریں۔"
LangString unknown ${LANG_URDU} "نامعلوم"
LangString webview2AbortError ${LANG_URDU} "WebView2 انسٹال کرنے میں ناکام! ایپ اس کے بغیر نہیں چل سکتی۔ انسٹالر کو دوبارہ شروع کرنے کی کوشش کریں۔"
LangString webview2DownloadError ${LANG_URDU} "خرابی: WebView2 کو ڈاؤن لوڈ کرنا ناکام ہو گیا - $0"
LangString webview2DownloadSuccess ${LANG_URDU} "WebView2 بوٹسٹریپر کامیابی سے ڈاؤن لوڈ ہو گیا۔"
LangString webview2Downloading ${LANG_URDU} "WebView2 بوٹسٹریپر ڈاؤن لوڈ ہو رہا ہے..."
LangString webview2InstallError ${LANG_URDU} "خرابی: ایگزٹ کوڈ $1 کے ساتھ WebView2 انسٹال کرنا ناکام ہوگیا۔"
LangString webview2InstallSuccess ${LANG_URDU} "WebView2 کامیابی سے انسٹال ہو گیا۔"
LangString deleteAppData ${LANG_URDU} "درخواست کا ڈیٹا حذف کریں۔"
