LangString alreadyInstalledLong ${LANG_MALAY} "${PRODUCTNAME} ${VERSION} sudah dipasang. Pilih operasi yang anda mahu lakukan dan klik Seterusnya untuk meneruskan."
LangString appRunning ${LANG_MALAY} "{{product_name}} sedang berjalan! Sila tutup dahulu kemudian cuba lagi."
LangString appRunningOkKill ${LANG_MALAY} "{{product_name}} sedang berjalan!$\n Klik OK untuk mematikannya"
LangString chooseMaintenanceOption ${LANG_MALAY} "Pilih pilihan penyelenggaraan untuk dilakukan."
LangString choowHowToInstall ${LANG_MALAY} "Pilih cara anda mahu memasang ${PRODUCTNAME}."
LangString createDesktop ${LANG_MALAY} "Buat pintasan desktop"
LangString dontUninstall ${LANG_MALAY} "Jangan nyahpasang"
LangString dontUninstallDowngrade ${LANG_MALAY} "Jangan nyahpasang (Penurunan taraf tanpa nyahpasang dilumpuhkan untuk pemasang ini)"
