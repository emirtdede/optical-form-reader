LangString choowHowToInstall ${LANG_SWAHILI} "Chagua jinsi ungependa kusakinisha ${PRODUCTNAME}."
LangString createDesktop ${LANG_SWAHILI} "Unda njia ya mkato ya eneo-kazi"
LangString dontUninstall ${LANG_SWAHILI} "Usiondoe"
