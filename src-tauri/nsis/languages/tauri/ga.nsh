LangString addOrReinstall ${LANG_IRISH} "Cuir leis/athshuiteáil comhpháirteanna"
LangString alreadyInstalled ${LANG_IRISH} "Suiteáilte Cheana"
LangString alreadyInstalledLong ${LANG_IRISH} "${PRODUCTNAME} ${VERSION} suiteáilte cheana féin. Roghnaigh an oibríocht is mian leat a dhéanamh agus cliceáil Ar Aghaidh chun leanúint ar aghaidh."
LangString appRunning ${LANG_IRISH} "Tá {{product_name}} ag rith! Dún é ar dtús agus bain triail eile as."
LangString appRunningOkKill ${LANG_IRISH} "{{product_name}} ag rith!$\n Cliceáil OK chun é a mharú"
LangString chooseMaintenanceOption ${LANG_IRISH} "Roghnaigh an rogha cothabhála le feidhmiú."
LangString choowHowToInstall ${LANG_IRISH} "Roghnaigh conas is mian leat ${PRODUCTNAME} a shuiteáil."
LangString createDesktop ${LANG_IRISH} "Cruthaigh aicearra deisce"
LangString dontUninstall ${LANG_IRISH} "Ná díshuiteáil"
LangString dontUninstallDowngrade ${LANG_IRISH} "Ná díshuiteáil (Tá íosghrádú gan díshuiteáil díchumasaithe don suiteálaí seo)"
LangString failedToKillApp ${LANG_IRISH} "Theip ar {{product_name}} a mharú. Dún é ar dtús agus bain triail eile as"
LangString installingWebview2 ${LANG_IRISH} "Suiteáil WebView2..."
LangString newerVersionInstalled ${LANG_IRISH} "Tá leagan níos nuaí de ${PRODUCTNAME} suiteáilte cheana féin! Ní mholtar duit leagan níos sine a shuiteáil. Más mian leat an leagan níos sine seo a shuiteáil, is fearr an leagan reatha a dhíshuiteáil ar dtús. Roghnaigh an oibríocht is mian leat a dhéanamh agus cliceáil Ar Aghaidh chun leanúint ar aghaidh."
LangString older ${LANG_IRISH} "níos sine"
LangString olderOrUnknownVersionInstalled ${LANG_IRISH} "Tá leagan $R4 de ${PRODUCTNAME} suiteáilte ar do chóras. Moltar duit an leagan reatha a dhíshuiteáil roimh é a shuiteáil. Roghnaigh an oibríocht is mian leat a dhéanamh agus cliceáil Ar Aghaidh chun leanúint ar aghaidh."
LangString silentDowngrades ${LANG_IRISH} "Tá íosghráduithe díchumasaithe don suiteálaí seo, ní féidir dul ar aghaidh leis an suiteálaí ciúin, bain úsáid as an suiteálaí comhéadan grafach ina ionad sin.$\n"
LangString unableToUninstall ${LANG_IRISH} "Ní féidir díshuiteáil!"
LangString uninstallApp ${LANG_IRISH} "Díshuiteáil ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_IRISH} "Díshuiteáil roimh shuiteáil"
LangString unknown ${LANG_IRISH} "anaithnid"
LangString webview2AbortError ${LANG_IRISH} "Theip ar shuiteáil WebView2! Ní féidir leis an aip rith gan é. Bain triail as an suiteálaí a atosú."
LangString webview2DownloadError ${LANG_IRISH} "Earráid: Theip ar íosluchtú WebView2 - $0"
LangString webview2DownloadSuccess ${LANG_IRISH} "D'éirigh le híoslódáil bootstrapper WebView2"
LangString webview2Downloading ${LANG_IRISH} "Íosluchtaigh webview2 bootstrapper. ."
LangString webview2InstallError ${LANG_IRISH} "Earráid: Theip ar shuiteáil WebView2 leis an gcód scoir $1"
LangString webview2InstallSuccess ${LANG_IRISH} "D'éirigh le suiteáil WebView2"
LangString deleteAppData ${LANG_IRISH} "Scrios sonraí an fheidhmchláir"
