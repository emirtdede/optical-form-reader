LangString addOrReinstall ${LANG_BOSNIAN} "Dodajte/reinstalirajte komponente"
LangString alreadyInstalled ${LANG_BOSNIAN} "Već instalirano"
LangString alreadyInstalledLong ${LANG_BOSNIAN} "${PRODUCTNAME} ${VERSION} je već instaliran. Odaberite operaciju koju želite izvršiti i kliknite na Dalje za nastavak."
LangString appRunning ${LANG_BOSNIAN} "{{product_name}} radi! Prvo ga zatvorite pa pokušajte ponovo."
LangString appRunningOkKill ${LANG_BOSNIAN} "{{product_name}} radi! $\n Kliknite OK da ga ubijete"
LangString chooseMaintenanceOption ${LANG_BOSNIAN} "Odaberite opciju održavanja koju želite izvršiti."
LangString choowHowToInstall ${LANG_BOSNIAN} "Odaberite kako želite instalirati ${PRODUCTNAME}."
LangString createDesktop ${LANG_BOSNIAN} "Kreirajte prečicu na radnoj površini"
LangString dontUninstall ${LANG_BOSNIAN} "Nemojte deinstalirati"
LangString dontUninstallDowngrade ${LANG_BOSNIAN} "Nemojte deinstalirati (Prelazak na stariju verziju bez deinstalacije je onemogućen za ovaj instalater)"
LangString failedToKillApp ${LANG_BOSNIAN} "Nije uspjelo ubiti {{product_name}}. Prvo ga zatvorite pa pokušajte ponovo"
LangString installingWebview2 ${LANG_BOSNIAN} "Instaliranje WebView2..."
LangString newerVersionInstalled ${LANG_BOSNIAN} "Novija verzija ${PRODUCTNAME} je već instalirana! Ne preporučuje se da instalirate stariju verziju. Ako zaista želite da instalirate ovu stariju verziju, bolje je da prvo deinstalirate trenutnu verziju. Odaberite operaciju koju želite izvršiti i kliknite na Dalje za nastavak."
LangString older ${LANG_BOSNIAN} "stariji"
LangString olderOrUnknownVersionInstalled ${LANG_BOSNIAN} "$R4 verzija ${PRODUCTNAME} je instalirana na vašem sistemu. Preporučuje se da deinstalirate trenutnu verziju prije instaliranja. Odaberite operaciju koju želite izvršiti i kliknite na Dalje za nastavak."
LangString silentDowngrades ${LANG_BOSNIAN} "Za ovaj instalater su onemogućene stare verzije, ne može se nastaviti s tihim instalacijskim programom, umjesto toga koristite program za instalaciju grafičkog sučelja.$\n"
LangString unableToUninstall ${LANG_BOSNIAN} "Nije moguće deinstalirati!"
LangString uninstallApp ${LANG_BOSNIAN} "Deinstalirajte ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_BOSNIAN} "Deinstalirajte prije instaliranja"
LangString unknown ${LANG_BOSNIAN} "nepoznato"
LangString webview2AbortError ${LANG_BOSNIAN} "Instalacija WebView2 nije uspjela! Aplikacija ne može raditi bez toga. Pokušajte ponovo pokrenuti instalater."
LangString webview2DownloadError ${LANG_BOSNIAN} "Greška: Preuzimanje WebView2 nije uspjelo - $0"
LangString webview2DownloadSuccess ${LANG_BOSNIAN} "WebView2 bootstrapper je uspješno preuzet"
LangString webview2Downloading ${LANG_BOSNIAN} "Preuzimanje WebView2 bootstrappera..."
LangString webview2InstallError ${LANG_BOSNIAN} "Greška: Instalacija WebView2 nije uspjela sa izlaznim kodom $1"
LangString webview2InstallSuccess ${LANG_BOSNIAN} "WebView2 je uspješno instaliran"
LangString deleteAppData ${LANG_BOSNIAN} "Izbrišite podatke aplikacije"
