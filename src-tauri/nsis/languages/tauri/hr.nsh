LangString addOrReinstall ${LANG_CROATIAN} "Dodajte/ponovno instalirajte komponente"
LangString alreadyInstalled ${LANG_CROATIAN} "Već instalirano"
LangString alreadyInstalledLong ${LANG_CROATIAN} "${PRODUCTNAME} ${VERSION} je već instaliran. Odaberite operaciju koju želite izvesti i kliknite Dalje za nastavak."
LangString appRunning ${LANG_CROATIAN} "{{product_name}} trči! Prvo ga zatvorite, a zatim pokušajte ponovno."
LangString appRunningOkKill ${LANG_CROATIAN} "{{product_name}} radi!$\n Kliknite OK da ga ubijete"
LangString chooseMaintenanceOption ${LANG_CROATIAN} "Odaberite opciju održavanja koju želite izvršiti."
LangString choowHowToInstall ${LANG_CROATIAN} "Odaberite kako želite instalirati ${PRODUCTNAME}."
LangString createDesktop ${LANG_CROATIAN} "Stvorite prečac na radnoj površini"
LangString dontUninstall ${LANG_CROATIAN} "Nemojte deinstalirati"
LangString dontUninstallDowngrade ${LANG_CROATIAN} "Nemoj deinstalirati (prelazak na stariju verziju bez deinstalacije onemogućen je za ovaj instalacijski program)"
LangString failedToKillApp ${LANG_CROATIAN} "Nije uspjelo ubiti {{product_name}}. Prvo ga zatvorite, a zatim pokušajte ponovno"
LangString installingWebview2 ${LANG_CROATIAN} "Instaliranje WebView2..."
LangString newerVersionInstalled ${LANG_CROATIAN} "Novija verzija ${PRODUCTNAME} je već instalirana! Ne preporučuje se instaliranje starije verzije. Ako stvarno želite instalirati ovu stariju verziju, bolje je prvo deinstalirati trenutnu verziju. Odaberite operaciju koju želite izvesti i kliknite Dalje za nastavak."
LangString older ${LANG_CROATIAN} "stariji"
LangString olderOrUnknownVersionInstalled ${LANG_CROATIAN} "$R4 verzija ${PRODUCTNAME} instalirana je na vašem sustavu. Preporučuje se da deinstalirate trenutnu verziju prije instalacije. Odaberite operaciju koju želite izvesti i kliknite Dalje za nastavak."
LangString silentDowngrades ${LANG_CROATIAN} "Vraćanje na stariju verziju onemogućeno je za ovaj instalacijski program, ne može se nastaviti s tihim instalacijskim programom, umjesto toga upotrijebite instalacijski program za grafičko sučelje.$\n"
LangString unableToUninstall ${LANG_CROATIAN} "Nije moguće deinstalirati!"
LangString uninstallApp ${LANG_CROATIAN} "Deinstalirajte ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_CROATIAN} "Deinstalirajte prije instaliranja"
LangString unknown ${LANG_CROATIAN} "nepoznato"
LangString webview2AbortError ${LANG_CROATIAN} "Instalacija WebView2 nije uspjela! Aplikacija ne može raditi bez toga. Pokušajte ponovo pokrenuti instalacijski program."
LangString webview2DownloadError ${LANG_CROATIAN} "Pogreška: Preuzimanje WebView2 nije uspjelo - $0"
LangString webview2DownloadSuccess ${LANG_CROATIAN} "Program za pokretanje WebView2 uspješno je preuzet"
LangString webview2Downloading ${LANG_CROATIAN} "Preuzimanje programa za pokretanje WebView2..."
LangString webview2InstallError ${LANG_CROATIAN} "Pogreška: instaliranje WebView2 nije uspjelo s izlaznim kodom $1"
LangString webview2InstallSuccess ${LANG_CROATIAN} "WebView2 je uspješno instaliran"
