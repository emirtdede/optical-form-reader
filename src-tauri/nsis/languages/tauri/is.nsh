LangString dontUninstall ${LANG_ICELANDIC} "Ekki fjarlægja"
LangString dontUninstallDowngrade ${LANG_ICELANDIC} "Ekki fjarlægja (niðurfærsla án þess að fjarlægja er óvirkt fyrir þetta uppsetningarforrit)"
