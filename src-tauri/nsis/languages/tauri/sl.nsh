LangString addOrReinstall ${LANG_SLOVENIAN} "Dodajte/znova namestite komponente"
LangString alreadyInstalled ${LANG_SLOVENIAN} "Že nameščeno"
LangString alreadyInstalledLong ${LANG_SLOVENIAN} "${PRODUCTNAME} ${VERSION} je že nameščen. Izberite operacijo, ki jo želite izvesti, in kliknite Naprej za nadaljevanje."
LangString appRunning ${LANG_SLOVENIAN} "{{product_name}} teče! Najprej ga zaprite in nato poskusite znova."
LangString appRunningOkKill ${LANG_SLOVENIAN} "{{product_name}} teče!$\n Kliknite OK, da ga ubijete"
LangString chooseMaintenanceOption ${LANG_SLOVENIAN} "Izberite možnost vzdrževanja, ki jo želite izvesti."
LangString choowHowToInstall ${LANG_SLOVENIAN} "Izberite, kako želite namestiti ${PRODUCTNAME}."
LangString createDesktop ${LANG_SLOVENIAN} "Ustvarite bližnjico na namizju"
LangString dontUninstall ${LANG_SLOVENIAN} "Ne odstranite"
LangString dontUninstallDowngrade ${LANG_SLOVENIAN} "Ne odstrani (prehod na nižjo različico brez odstranitve je za ta namestitveni program onemogočen)"
LangString failedToKillApp ${LANG_SLOVENIAN} "{{product_name}} ni uspelo ubiti. Najprej ga zaprite in nato poskusite znova"
LangString installingWebview2 ${LANG_SLOVENIAN} "Namestitev WebView2 ..."
LangString newerVersionInstalled ${LANG_SLOVENIAN} "Novejša različica ${PRODUCTNAME} je že nameščena! Ni priporočljivo, da namestite starejšo različico. Če res želite namestiti to starejšo različico, je bolje, da najprej odstranite trenutno različico. Izberite operacijo, ki jo želite izvesti, in kliknite Naprej za nadaljevanje."
LangString older ${LANG_SLOVENIAN} "starejši"
LangString olderOrUnknownVersionInstalled ${LANG_SLOVENIAN} "V vašem sistemu je nameščena različica $R4 ${PRODUCTNAME}. Priporočljivo je, da pred namestitvijo odstranite trenutno različico. Izberite operacijo, ki jo želite izvesti, in kliknite Naprej za nadaljevanje."
LangString silentDowngrades ${LANG_SLOVENIAN} "Prehodi na nižjo različico so za ta namestitveni program onemogočeni, ni mogoče nadaljevati s tihim namestitvenim programom, namesto tega uporabite namestitveni program z grafičnim vmesnikom.$\n"
LangString unableToUninstall ${LANG_SLOVENIAN} "Ni mogoče odstraniti!"
LangString uninstallApp ${LANG_SLOVENIAN} "Odstranite ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_SLOVENIAN} "Odstranite pred namestitvijo"
LangString unknown ${LANG_SLOVENIAN} "neznano"
LangString webview2AbortError ${LANG_SLOVENIAN} "Namestitev WebView2 ni uspela! Brez tega aplikacija ne more delovati. Poskusite znova zagnati namestitveni program."
LangString webview2DownloadError ${LANG_SLOVENIAN} "Napaka: prenos WebView2 ni uspel - $0"
LangString webview2DownloadSuccess ${LANG_SLOVENIAN} "Zagonski program WebView2 je bil uspešno prenesen"
LangString webview2Downloading ${LANG_SLOVENIAN} "Prenašanje zagonskega programa WebView2 ..."
LangString webview2InstallError ${LANG_SLOVENIAN} "Napaka: namestitev WebView2 ni uspela z izhodno kodo $1"
LangString webview2InstallSuccess ${LANG_SLOVENIAN} "WebView2 je bil uspešno nameščen"
LangString deleteAppData ${LANG_SLOVENIAN} "Izbrišite podatke aplikacije"
