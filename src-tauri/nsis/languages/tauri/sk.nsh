LangString addOrReinstall ${LANG_SLOVAK} "Pridať/preinštalovať komponenty"
LangString alreadyInstalled ${LANG_SLOVAK} "Už nainštalované"
LangString alreadyInstalledLong ${LANG_SLOVAK} "${PRODUCTNAME} ${VERSION} je už nainštalovaný. Vyberte operáciu, ktorú chcete vykonať, a pokračujte kliknutím na Ďalej."
LangString appRunning ${LANG_SLOVAK} "{{product_name}} beží! Najprv ho zatvorte a potom to skúste znova."
LangString appRunningOkKill ${LANG_SLOVAK} "{{product_name}} beží! $\n Kliknutím na tlačidlo OK ho ukončíte"
LangString chooseMaintenanceOption ${LANG_SLOVAK} "Vyberte možnosť údržby, ktorú chcete vykonať."
LangString choowHowToInstall ${LANG_SLOVAK} "Vyberte, ako chcete nainštalovať ${PRODUCTNAME}."
LangString createDesktop ${LANG_SLOVAK} "Vytvorte skratku na pracovnej ploche"
LangString dontUninstall ${LANG_SLOVAK} "Neodinštalujte"
LangString dontUninstallDowngrade ${LANG_SLOVAK} "Neodinštalovať (prechod na staršiu verziu bez odinštalovania je pre tento inštalátor zakázaný)"
LangString failedToKillApp ${LANG_SLOVAK} "Nepodarilo sa zabiť {{product_name}}. Najprv ho zatvorte a potom to skúste znova"
LangString installingWebview2 ${LANG_SLOVAK} "Inštaluje sa WebView2..."
LangString newerVersionInstalled ${LANG_SLOVAK} "Je už nainštalovaná novšia verzia ${PRODUCTNAME}! Neodporúča sa inštalovať staršiu verziu. Ak naozaj chcete nainštalovať túto staršiu verziu, je lepšie najprv odinštalovať aktuálnu verziu. Vyberte operáciu, ktorú chcete vykonať, a pokračujte kliknutím na Ďalej."
LangString older ${LANG_SLOVAK} "starší"
LangString olderOrUnknownVersionInstalled ${LANG_SLOVAK} "Vo vašom systéme je nainštalovaná verzia $R4 ${PRODUCTNAME}. Pred inštaláciou sa odporúča odinštalovať aktuálnu verziu. Vyberte operáciu, ktorú chcete vykonať, a pokračujte kliknutím na Ďalej."
LangString silentDowngrades ${LANG_SLOVAK} "Prechod na nižšiu verziu je pre tento inštalačný program vypnutý, nemôže pokračovať v tichom inštalátore, použite namiesto neho inštalačný program grafického rozhrania.$\n"
LangString unableToUninstall ${LANG_SLOVAK} "Nedá sa odinštalovať!"
LangString uninstallApp ${LANG_SLOVAK} "Odinštalovať ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_SLOVAK} "Pred inštaláciou odinštalujte"
LangString unknown ${LANG_SLOVAK} "neznámy"
LangString webview2AbortError ${LANG_SLOVAK} "Nepodarilo sa nainštalovať WebView2! Aplikácia sa bez nej nedá spustiť. Skúste reštartovať inštalačný program."
LangString webview2DownloadError ${LANG_SLOVAK} "Chyba: Sťahovanie WebView2 zlyhalo - $0"
LangString webview2DownloadSuccess ${LANG_SLOVAK} "Bootstrapper WebView2 bol úspešne stiahnutý"
LangString webview2Downloading ${LANG_SLOVAK} "Sťahuje sa bootstrapper WebView2..."
LangString webview2InstallError ${LANG_SLOVAK} "Chyba: Inštalácia WebView2 zlyhala s kódom ukončenia $1"
LangString webview2InstallSuccess ${LANG_SLOVAK} "WebView2 sa úspešne nainštaloval"
LangString deleteAppData ${LANG_SLOVAK} "Vymažte údaje aplikácie"
