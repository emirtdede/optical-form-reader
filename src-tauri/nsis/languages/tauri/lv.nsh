LangString addOrReinstall ${LANG_LATVIAN} "Pievienojiet/pārinstalējiet komponentus"
LangString alreadyInstalled ${LANG_LATVIAN} "Jau instalēts"
LangString alreadyInstalledLong ${LANG_LATVIAN} "${PRODUCTNAME} ${VERSION} jau ir instalēts. Atlasiet darbību, kuru vēlaties veikt, un noklikšķiniet uz Tālāk, lai turpinātu."
LangString appRunning ${LANG_LATVIAN} "{{product_name}} darbojas! Lūdzu, vispirms aizveriet to un pēc tam mēģiniet vēlreiz."
LangString appRunningOkKill ${LANG_LATVIAN} "{{product_name}} darbojas!$\n Noklikšķiniet uz Labi, lai to iznīcinātu"
LangString chooseMaintenanceOption ${LANG_LATVIAN} "Izvēlieties veicamo apkopes opciju."
LangString choowHowToInstall ${LANG_LATVIAN} "Izvēlieties, kā vēlaties instalēt ${PRODUCTNAME}."
LangString createDesktop ${LANG_LATVIAN} "Izveidojiet darbvirsmas saīsni"
LangString dontUninstall ${LANG_LATVIAN} "Neatinstalēt"
LangString dontUninstallDowngrade ${LANG_LATVIAN} "Neatinstalēt (šim instalētājam ir atspējota lejupielāde bez atinstalēšanas)"
LangString failedToKillApp ${LANG_LATVIAN} "Neizdevās nogalināt {{product_name}}. Lūdzu, vispirms aizveriet to un pēc tam mēģiniet vēlreiz"
LangString installingWebview2 ${LANG_LATVIAN} "Notiek WebView2 instalēšana..."
LangString newerVersionInstalled ${LANG_LATVIAN} "Jaunāka ${PRODUCTNAME} versija jau ir instalēta! Nav ieteicams instalēt vecāku versiju. Ja tiešām vēlaties instalēt šo vecāku versiju, labāk ir vispirms atinstalēt pašreizējo versiju. Atlasiet darbību, kuru vēlaties veikt, un noklikšķiniet uz Tālāk, lai turpinātu."
LangString older ${LANG_LATVIAN} "vecāks"
LangString olderOrUnknownVersionInstalled ${LANG_LATVIAN} "Jūsu sistēmā ir instalēta $R4 ${PRODUCTNAME} versija. Pirms instalēšanas ieteicams atinstalēt pašreizējo versiju. Atlasiet darbību, kuru vēlaties veikt, un noklikšķiniet uz Tālāk, lai turpinātu."
LangString silentDowngrades ${LANG_LATVIAN} "Šim instalēšanas programmai ir atspējota lejupielāde, nevar turpināt ar kluso instalēšanas programmu. Lūdzu, izmantojiet grafiskā interfeisa instalēšanas programmu.$\n"
LangString unableToUninstall ${LANG_LATVIAN} "Nevar atinstalēt!"
LangString uninstallApp ${LANG_LATVIAN} "Atinstalējiet ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_LATVIAN} "Pirms instalēšanas atinstalējiet"
LangString unknown ${LANG_LATVIAN} "nezināms"
LangString webview2AbortError ${LANG_LATVIAN} "Neizdevās instalēt WebView2! Lietojumprogramma nevar darboties bez tās. Mēģiniet restartēt instalētāju."
LangString webview2DownloadError ${LANG_LATVIAN} "Kļūda: WebView2 lejupielāde neizdevās - $0"
LangString webview2DownloadSuccess ${LANG_LATVIAN} "WebView2 sāknēšanas programma ir veiksmīgi lejupielādēta"
LangString webview2Downloading ${LANG_LATVIAN} "Notiek WebView2 bootstrapper lejupielāde..."
LangString webview2InstallError ${LANG_LATVIAN} "Kļūda: WebView2 instalēšana neizdevās ar izejas kodu $1"
LangString webview2InstallSuccess ${LANG_LATVIAN} "WebView2 ir veiksmīgi instalēts"
