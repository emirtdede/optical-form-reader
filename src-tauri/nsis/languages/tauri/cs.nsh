LangString addOrReinstall ${LANG_CZECH} "Přidat/přeinstalovat součásti"
LangString alreadyInstalled ${LANG_CZECH} "Již nainstalováno"
LangString alreadyInstalledLong ${LANG_CZECH} "${PRODUCTNAME} ${VERSION} je již nainstalován. Vyberte operaci, kterou chcete provést, a pokračujte kliknutím na tlačítko Další."
LangString appRunning ${LANG_CZECH} "{{product_name}} běží! Nejprve jej zavřete a zkuste to znovu."
LangString appRunningOkKill ${LANG_CZECH} "{{product_name}} běží! $\n Klepnutím na OK jej ukončíte"
LangString chooseMaintenanceOption ${LANG_CZECH} "Vyberte možnost údržby, kterou chcete provést."
LangString choowHowToInstall ${LANG_CZECH} "Vyberte, jak chcete ${PRODUCTNAME} nainstalovat."
LangString createDesktop ${LANG_CZECH} "Vytvořit zástupce na ploše"
LangString dontUninstall ${LANG_CZECH} "Neodinstalujte"
LangString dontUninstallDowngrade ${LANG_CZECH} "Neodinstalovat (přechod na nižší verzi bez odinstalace je pro tento instalační program zakázán)"
LangString failedToKillApp ${LANG_CZECH} "Nepodařilo se zabít {{product_name}}. Nejprve jej zavřete a zkuste to znovu"
LangString installingWebview2 ${LANG_CZECH} "Instalace WebView2..."
LangString newerVersionInstalled ${LANG_CZECH} "Novější verze ${PRODUCTNAME} je již nainstalována! Nedoporučuje se instalovat starší verzi. Pokud opravdu chcete nainstalovat tuto starší verzi, je lepší nejprve odinstalovat aktuální verzi. Vyberte operaci, kterou chcete provést, a pokračujte kliknutím na tlačítko Další."
LangString older ${LANG_CZECH} "starší"
LangString olderOrUnknownVersionInstalled ${LANG_CZECH} "Ve vašem systému je nainstalována verze $R4 ${PRODUCTNAME}. Před instalací se doporučuje odinstalovat aktuální verzi. Vyberte operaci, kterou chcete provést, a pokračujte kliknutím na tlačítko Další."
LangString silentDowngrades ${LANG_CZECH} "Downgrady jsou pro tento instalační program zakázány, nelze pokračovat v tiché instalaci, použijte místo toho instalační program grafického rozhraní.$\n"
LangString unableToUninstall ${LANG_CZECH} "Nelze odinstalovat!"
LangString uninstallApp ${LANG_CZECH} "Odinstalovat ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_CZECH} "Před instalací odinstalujte"
LangString unknown ${LANG_CZECH} "neznámý"
LangString webview2AbortError ${LANG_CZECH} "Instalace WebView2 se nezdařila! Aplikace bez něj nemůže běžet. Zkuste restartovat instalační program."
LangString webview2DownloadError ${LANG_CZECH} "Chyba: Stahování WebView2 se nezdařilo - $0"
LangString webview2DownloadSuccess ${LANG_CZECH} "Bootstrapper WebView2 byl úspěšně stažen"
LangString webview2Downloading ${LANG_CZECH} "Stahování bootstrapperu WebView2..."
LangString webview2InstallError ${LANG_CZECH} "Chyba: Instalace WebView2 se nezdařila s kódem ukončení $1"
LangString webview2InstallSuccess ${LANG_CZECH} "WebView2 byl úspěšně nainstalován"
LangString deleteAppData ${LANG_CZECH} "Smažte data aplikace"
