LangString addOrReinstall ${LANG_KHMER} "បន្ថែម/ដំឡើងសមាសធាតុឡើងវិញ"
LangString alreadyInstalled ${LANG_KHMER} "បានដំឡើងរួចហើយ"
LangString alreadyInstalledLong ${LANG_KHMER} "${PRODUCTNAME} ${VERSION} ត្រូវបានដំឡើងរួចហើយ។ ជ្រើសរើសប្រតិបត្តិការដែលអ្នកចង់អនុវត្ត ហើយចុច បន្ទាប់ ដើម្បីបន្ត។"
LangString appRunning ${LANG_KHMER} "{{product_name}} កំពុងដំណើរការ! សូមបិទវាជាមុនសិន រួចព្យាយាមម្តងទៀត។"
LangString appRunningOkKill ${LANG_KHMER} "{{product_name}} កំពុងដំណើរការ!$\n ចុចយល់ព្រមដើម្បីសម្លាប់វា។"
LangString chooseMaintenanceOption ${LANG_KHMER} "ជ្រើសរើសជម្រើសថែទាំដើម្បីអនុវត្ត។"
LangString choowHowToInstall ${LANG_KHMER} "ជ្រើសរើសរបៀបដែលអ្នកចង់ដំឡើង ${PRODUCTNAME} ។"
LangString createDesktop ${LANG_KHMER} "បង្កើតផ្លូវកាត់ផ្ទៃតុ"
LangString dontUninstall ${LANG_KHMER} "កុំលុបការដំឡើង"
LangString dontUninstallDowngrade ${LANG_KHMER} "កុំ​លុប​ចោល (ការ​ទម្លាក់​ចំណាត់​ថ្នាក់​ដោយ​គ្មាន​ការ​លុប​ត្រូវ​បាន​បិទ​សម្រាប់​កម្មវិធី​ដំឡើង​នេះ)"
LangString failedToKillApp ${LANG_KHMER} "បរាជ័យក្នុងការសម្លាប់ {{product_name}} ។ សូមបិទវាជាមុនសិន រួចព្យាយាមម្តងទៀត"
LangString installingWebview2 ${LANG_KHMER} "កំពុងដំឡើង WebView2..."
LangString newerVersionInstalled ${LANG_KHMER} "កំណែថ្មីនៃ ${PRODUCTNAME} ត្រូវបានដំឡើងរួចហើយ! វាមិនត្រូវបានណែនាំអោយអ្នកដំឡើងកំណែចាស់នោះទេ។ ប្រសិនបើអ្នកពិតជាចង់ដំឡើងកំណែចាស់នេះ វាជាការប្រសើរក្នុងការលុបកំណែបច្ចុប្បន្នជាមុនសិន។ ជ្រើសរើសប្រតិបត្តិការដែលអ្នកចង់អនុវត្ត ហើយចុច បន្ទាប់ ដើម្បីបន្ត។"
LangString older ${LANG_KHMER} "ចាស់ជាង"
LangString olderOrUnknownVersionInstalled ${LANG_KHMER} "កំណែ $R4 នៃ ${PRODUCTNAME} ត្រូវបានដំឡើងនៅលើប្រព័ន្ធរបស់អ្នក។ វាត្រូវបានណែនាំឱ្យអ្នកលុបកំណែបច្ចុប្បន្នមុនពេលដំឡើង។ ជ្រើសរើសប្រតិបត្តិការដែលអ្នកចង់អនុវត្ត ហើយចុច បន្ទាប់ ដើម្បីបន្ត។"
LangString silentDowngrades ${LANG_KHMER} "ការទម្លាក់ចំណាត់ថ្នាក់ត្រូវបានបិទសម្រាប់កម្មវិធីដំឡើងនេះ មិនអាចបន្តជាមួយកម្មវិធីដំឡើងស្ងាត់បានទេ សូមប្រើកម្មវិធីដំឡើងចំណុចប្រទាក់ក្រាហ្វិកជំនួសវិញ។$\n"
LangString unableToUninstall ${LANG_KHMER} "មិនអាចលុបបានទេ!"
LangString uninstallApp ${LANG_KHMER} "លុបការដំឡើង ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_KHMER} "លុបការដំឡើងមុនពេលដំឡើង"
LangString unknown ${LANG_KHMER} "មិនស្គាល់"
LangString webview2AbortError ${LANG_KHMER} "បរាជ័យក្នុងការដំឡើង WebView2! កម្មវិធីនេះមិនអាចដំណើរការដោយគ្មានវាទេ។ ព្យាយាមចាប់ផ្តើមកម្មវិធីដំឡើងឡើងវិញ។"
LangString webview2DownloadError ${LANG_KHMER} "កំហុស៖ ការទាញយក WebView2 បានបរាជ័យ - $0"
