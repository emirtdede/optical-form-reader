LangString addOrReinstall ${LANG_ALBANIAN} "Shtoni/riinstaloni komponentë"
LangString alreadyInstalled ${LANG_ALBANIAN} "I instaluar tashmë"
LangString alreadyInstalledLong ${LANG_ALBANIAN} "${PRODUCTNAME} ${VERSION} është instaluar tashmë. Zgjidhni operacionin që dëshironi të kryeni dhe klikoni Pasuesi për të vazhduar."
LangString appRunning ${LANG_ALBANIAN} "{{product_name}} po funksionon! Ju lutemi mbylleni fillimisht dhe provoni sërish."
LangString appRunningOkKill ${LANG_ALBANIAN} "{{product_name}} po funksionon! $\n Kliko OK për ta vrarë"
LangString chooseMaintenanceOption ${LANG_ALBANIAN} "Zgjidhni opsionin e mirëmbajtjes për të kryer."
LangString choowHowToInstall ${LANG_ALBANIAN} "Zgjidhni se si dëshironi të instaloni ${PRODUCTNAME}."
LangString createDesktop ${LANG_ALBANIAN} "Krijo shkurtore në desktop"
LangString dontUninstall ${LANG_ALBANIAN} "Mos e çinstaloni"
LangString dontUninstallDowngrade ${LANG_ALBANIAN} "Mos e çinstaloni (Zvogëlimi pa çinstalim është i çaktivizuar për këtë instalues)"
LangString failedToKillApp ${LANG_ALBANIAN} "Vrasja e {{product_name}} dështoi. Ju lutemi mbylleni fillimisht dhe provoni sërish"
LangString installingWebview2 ${LANG_ALBANIAN} "Po instalon WebView2..."
LangString newerVersionInstalled ${LANG_ALBANIAN} "Një version më i ri i ${PRODUCTNAME} është instaluar tashmë! Nuk rekomandohet të instaloni një version më të vjetër. Nëse vërtet dëshironi të instaloni këtë version të vjetër, është më mirë të çinstaloni fillimisht versionin aktual. Zgjidhni operacionin që dëshironi të kryeni dhe klikoni Pasuesi për të vazhduar."
LangString older ${LANG_ALBANIAN} "më të vjetra"
LangString olderOrUnknownVersionInstalled ${LANG_ALBANIAN} "Një version $R4 i ${PRODUCTNAME} është instaluar në sistemin tuaj. Rekomandohet që të çinstaloni versionin aktual përpara se ta instaloni. Zgjidhni operacionin që dëshironi të kryeni dhe klikoni Pasuesi për të vazhduar."
LangString silentDowngrades ${LANG_ALBANIAN} "Uljet janë çaktivizuar për këtë instalues, nuk mund të vazhdohet me instaluesin e heshtur, ju lutemi përdorni instaluesin e ndërfaqes grafike në vend."
LangString unableToUninstall ${LANG_ALBANIAN} "Nuk mund të çinstalohet!"
LangString uninstallApp ${LANG_ALBANIAN} "Çinstaloni ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_ALBANIAN} "Çinstaloni përpara se ta instaloni"
LangString unknown ${LANG_ALBANIAN} "i panjohur"
LangString webview2AbortError ${LANG_ALBANIAN} "Instalimi i WebView2 dështoi! Aplikacioni nuk mund të funksionojë pa të. Provoni të rinisni instaluesin."
LangString webview2DownloadError ${LANG_ALBANIAN} "Gabim: Shkarkimi i WebView2 dështoi - $0"
LangString webview2DownloadSuccess ${LANG_ALBANIAN} "WebView2 bootstrapper u shkarkua me sukses"
LangString webview2Downloading ${LANG_ALBANIAN} "Po shkarkohet bootstrapper WebView2..."
LangString webview2InstallError ${LANG_ALBANIAN} "Gabim: Instalimi i WebView2 dështoi me kodin e daljes $1"
LangString webview2InstallSuccess ${LANG_ALBANIAN} "WebView2 u instalua me sukses"
